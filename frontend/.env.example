# Where the Next.js server proxies /api/* (the FastAPI backend). The browser never calls it directly.
LASTCALL_API_URL=http://127.0.0.1:8787
# On Render this is set instead, to the API's private host:port (see render.yaml):
# LASTCALL_API_HOSTPORT=lastcall-api:10000
# Bryntum Scheduler license key for the pickup timelines. Leave empty to run as a trial (shows a badge).
NEXT_PUBLIC_BRYNTUM_LICENSE_KEY=
