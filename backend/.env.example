# Copy to backend/.env for local development. Production values live in the Render dashboard.

# --- Runtime --------------------------------------------------------------------------------
# APP_ENV=development            # development | test | production
# LOG_JSON=false                 # human-readable logs locally

# --- Database -------------------------------------------------------------------------------
# Leave empty locally to use an embedded PostgreSQL (data in backend/.data/pg).
# Required in production (Render injects the internal connection string).
# DATABASE_URL=postgresql://lastcall:lastcall@localhost:5432/lastcall

# --- Web origin -----------------------------------------------------------------------------
# Browser-facing URL of the Next.js app (CSRF origin checks, links in emails).
PUBLIC_APP_URL=http://localhost:3787
# Signs sessions, tokens and pickup codes. Required in production; generated locally.
# SECRET_KEY=

# --- Operations -----------------------------------------------------------------------------
# WORKER_ENABLED=true            # in-process background worker; false if you run `python -m app.worker`
# METRICS_TOKEN=                 # bearer token for /api/metrics (hidden in production without one)
