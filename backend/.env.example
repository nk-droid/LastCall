# Copy to backend/.env for local development. Production values live in the Render dashboard.

# --- Runtime --------------------------------------------------------------------------------
# APP_ENV=development            # development | test | production
# LOG_JSON=false                 # human-readable logs locally

# --- Database -------------------------------------------------------------------------------
# Leave empty locally to use an embedded PostgreSQL (data in backend/.data/pg).
# Required in production (Render injects the internal connection string).
# DATABASE_URL=postgresql://lastcall:lastcall@localhost:5432/lastcall

# --- Web origin -----------------------------------------------------------------------------
# Browser-facing URL of the Next.js app (CSRF origin checks, links in emails).
PUBLIC_APP_URL=http://localhost:3787
# Signs sessions, tokens and pickup codes. Required in production; generated locally.
# SECRET_KEY=

# --- Operations -----------------------------------------------------------------------------
# WORKER_ENABLED=true            # in-process background worker; false if you run `python -m app.worker`
# METRICS_TOKEN=                 # bearer token for /api/metrics (hidden in production without one)
# OPS_FAULTS_ENABLED=false       # let platform admins arm PayPal failure injection (recovery demos)

# --- PayPal ------------------------------------------------------------------------------------
# Required for checkout. Create a REST app in the PayPal Developer Dashboard and copy its client ID
# and secret. The API host is fixed to the PayPal Sandbox in this build (test money only).
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# Webhook ID from the app's webhook settings (https://<api-host>/api/webhooks/paypal). Without it,
# webhooks are rejected; capture results never depend on them (capture responses and the reconciler
# are authoritative).
# PAYPAL_WEBHOOK_ID=
# PAYPAL_BRAND_NAME=LastCall      # shown in PayPal's window when a shop has no payout account yet
# "Connect with PayPal" for shop payouts: in the PayPal app, turn on Log in with PayPal with the email and
# PayPal account ID (payer ID) / account verification attributes, and add <PUBLIC_APP_URL>/merchant/paypal/return
# as a return URL. Off by default: owners then enter their merchant ID.
# PAYPAL_CONNECT_ENABLED=true

# --- Email (SMTP) -------------------------------------------------------------------------------
# Receipts, ready-for-pickup, refunds, staff invites and password resets. Without SMTP_HOST the
# emails are skipped and the console shows invite/reset links to share. A Gmail account with an
# app password works: SMTP_HOST=smtp.gmail.com, SMTP_USERNAME=<address>, SMTP_PASSWORD=<app password>.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=LastCall <no-reply@lastcall.app>
# SMTP_STARTTLS=true

# --- AI (Ollama via LangChain) ----------------------------------------------------------------
# Ollama's cloud API needs an API key (ollama.com -> Settings -> Keys). Without one, AI stays off
# and every feature uses its deterministic rules.
# OLLAMA_API_KEY=
# LLM_PROVIDER=ollama            # or "none" for rules only
# OLLAMA_HOST=https://ollama.com # a local daemon also works: http://localhost:11434 with LLM_MODEL=gpt-oss:120b-cloud
# LLM_MODEL=gpt-oss:120b
# LLM_THINK=low
# LLM_TIMEOUT_SECONDS=20

# --- Showcase shops (python -m app.cli seed-showcase) -------------------------------------------
# SHOWCASE_PASSWORD=             # creates owner/manager/staff accounts for each showcase shop
# SHOWCASE_PAYEE_JUNIPER_RYE=    # PayPal Sandbox business account merchant ID per shop (optional)
# SHOWCASE_PAYEE_COPPER_KETTLE=
# SHOWCASE_PAYEE_GOLDEN_BUN=
# SHOWCASE_PAYEE_NIGHT_OWL=
